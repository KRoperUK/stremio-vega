# Rendered at container start; only ${SERVER_TOKEN} is substituted (the entry
# point sets NGINX_ENVSUBST_FILTER so nginx's own $variables survive).
#
# Layout of the single public origin:
#   /                          -> static stremio-web UI
#   /s/${SERVER_TOKEN}/...      -> reverse proxy to the streaming server
#
# Any request under /s/ without the exact token prefix is refused, so the
# public hostname is not an open transcoder.

server {
    listen 80;
    server_name _;

    # Reverse proxy to the streaming server, gated by the secret token segment.
    location /s/${SERVER_TOKEN}/ {
        # CORS preflight short-circuit.
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "$http_origin" always;
            add_header Access-Control-Allow-Methods "GET, HEAD, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "*" always;
            add_header Access-Control-Max-Age 86400 always;
            add_header Content-Length 0;
            add_header Content-Type text/plain;
            return 204;
        }

        # Resolve the upstream lazily via Docker's embedded DNS (127.0.0.11)
        # using a variable, so nginx does not fail to start when the
        # streaming-server container is not resolvable yet (startup ordering).
        # set must come before the `rewrite ... break`: break ends the rewrite
        # phase, so a set placed after it never runs and $upstream is empty.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $upstream http://streaming-server:11470;
        rewrite ^/s/${SERVER_TOKEN}/(.*)$ /$1 break;
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";

        # Streaming needs unbuffered, long-lived responses.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # NO CORS add_header here: the Stremio server (NO_CORS=1) already sends
        # Access-Control-Allow-Origin: * on its responses. Adding our own as
        # well produces TWO Access-Control-Allow-Origin headers, which browsers
        # reject as invalid — so the web client would report the server as
        # unreachable despite a 200. Preflight (OPTIONS) is handled above and
        # never reaches the upstream, so it keeps its own CORS headers.
    }

    # Anything else under /s/ (wrong or missing token) is refused.
    location /s/ {
        return 403;
    }

    # Static stremio-web UI (SPA: fall back to index.html).
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
