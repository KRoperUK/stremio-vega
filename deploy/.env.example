# Copy to .env and fill in. Not committed.

# Secret token gating the /api routes (probe/stream/addon). The app reads it
# from the server-injected index.html. Generate: openssl rand -hex 24
SERVER_TOKEN=change-me-to-a-long-random-string

# Loopback host port the container publishes on (the tunnel terminates TLS).
WEB_PORT=8080

# External Docker network the host reverse-proxy/tunnel uses to reach the
# container by name. Default matches a standard cloudflared compose stack.
# EDGE_NETWORK=cloudflared_cloudflared

# ffmpeg software-transcode tuning (GPU-less ARM VPS).
# X264_PRESET=veryfast
# X264_CRF=23
# MAX_BITRATE=8M
