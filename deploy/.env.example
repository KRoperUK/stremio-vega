# Copy to .env and fill in. None of these are committed.

# Secret path segment that gates the streaming server. Generate a long random
# value, e.g.  openssl rand -hex 24
# The app's streamingServerUrl must point at  https://<host>/s/<SERVER_TOKEN>/
SERVER_TOKEN=change-me-to-a-long-random-string

# Loopback host port the web container publishes on (a reverse proxy / tunnel
# in front of it terminates TLS and exposes it publicly). Default 8080.
WEB_PORT=8080
