# Build the stremio-web static bundle, then serve it (and a token-gated,
# CORS-adding reverse proxy to the streaming server) from nginx.
#
# Two stages so the published image carries only the static build + nginx, not
# the Node/pnpm toolchain.

# ---- build stremio-web ------------------------------------------------------
FROM node:22-bookworm-slim AS webbuild

ARG STREMIO_WEB_REF=development
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable

WORKDIR /src
RUN git clone --depth 1 --branch "${STREMIO_WEB_REF}" \
      https://github.com/Stremio/stremio-web.git . \
 && pnpm install --frozen-lockfile \
 && pnpm run build

# ---- runtime ----------------------------------------------------------------
FROM nginx:alpine

# Static UI.
COPY --from=webbuild /src/build /usr/share/nginx/html

# nginx config is rendered from a template at container start so the secret
# token path is injected from the environment (never baked into the image).
# Build context is deploy/ (see docker-compose.yml), so this path is relative
# to that, not the repo root.
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

# nginx:alpine runs envsubst over /etc/nginx/templates/*.template on startup,
# writing the result to /etc/nginx/conf.d/. ${SERVER_TOKEN} is substituted then.
EXPOSE 80
